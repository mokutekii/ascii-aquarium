{
  "name": "ascii-aquarium",
  "version": "1.2.0",
  "description": "An ASCII aquarium that reacts to Claude Code and Codex activity. Runs locally; no API keys.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "setup": "node install.cjs",
    "start": "node start.cjs",
    "stop": "node stop.cjs",
    "check": "node install.cjs --check",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node verify.cjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
